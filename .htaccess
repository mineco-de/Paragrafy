# Paragrafy Clean Apache Rewrite (Loop Protected)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteRule ^index\.php$ - [L]

    # Public-Cache-Verzeichnis (siehe cache.php/PARAGRAFY_DATA_DIR): bei Bare-Metal-Installs
    # kann es im Docroot liegen. Nie direkt per URL ausliefern (personenbezogene Daten je
    # Mandant im Cache-Inhalt) -- redundant zur generellen Rewrite-Regel, aber explizit.
    RewriteRule ^cache/ - [F,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.php [L]
</IfModule>

# Bare-metal self-hosted installs default PARAGRAFY_DATA_DIR to this same directory
# (see db.php), so DB/config/.env can end up sitting right next to the app code. Deny
# them at the webserver level as a safety net independent of any surrounding vhost
# config (Docker installs additionally keep this data outside the docroot entirely).
<IfModule mod_authz_core.c>
    <FilesMatch "\.(sqlite3?|sqlite-wal|sqlite-shm)$">
        Require all denied
    </FilesMatch>
    <Files "config.php">
        Require all denied
    </Files>
    <Files "config.lock">
        Require all denied
    </Files>
    <FilesMatch "^\.env">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(sqlite3?|sqlite-wal|sqlite-shm)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <Files "config.php">
        Order allow,deny
        Deny from all
    </Files>
    <Files "config.lock">
        Order allow,deny
        Deny from all
    </Files>
    <FilesMatch "^\.env">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
